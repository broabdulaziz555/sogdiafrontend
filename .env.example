# Root domain used to resolve www./app./trade./xdepartment. subdomains
NEXT_PUBLIC_ROOT_DOMAIN=sogdia.site

# Base URL of the SOGDIA backend API (contract v1.1.0).
# Same-origin default is "/api". For a separate backend use its origin, with or without "/api":
#   NEXT_PUBLIC_API_URL=https://sogdiabackend.onrender.com
# The client always appends "/api" when it is missing. Use API_PROXY_TARGET to proxy instead.
NEXT_PUBLIC_API_URL=/api
# API_PROXY_TARGET=https://api.sogdia.site

# Shown in the legal footer — fill in before launch
NEXT_PUBLIC_LEGAL_ENTITY=SOGDIA
NEXT_PUBLIC_SUPPORT_EMAIL=support@sogdia.site

# Terminal market data (public endpoints; override if your region blocks them)
# NEXT_PUBLIC_BINANCE_REST=https://data-api.binance.vision
# NEXT_PUBLIC_BINANCE_WS=wss://data-stream.binance.vision
